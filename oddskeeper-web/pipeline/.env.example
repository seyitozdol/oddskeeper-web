# pipeline/.env ornegi. Gercek degerler git'e GIRMEZ.
# VPS'te: /opt/oddskeeper/repo/oddskeeper-web/pipeline/.env

# Supabase REST (fetch_sofascore_matches, load_sofascore_* icin)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# Dogrudan Postgres baglantisi (fetch_upcoming_events psycopg2 ile yazar)
DATABASE_URL=

# DataImpulse residential proxy. Datacenter-IP engelleyen kaynaklar
# (SofaScore, FlashScore) bu proxy'den gecer. GB basina ucretli.
PROXY_URL=

# Bets10 oran yakalama icin TR-geo + sticky-session proxy (capture_odds_vps).
# DataImpulse username eki: ...__cr.tr;session-<id>
PROXY_ODDS_TR=
